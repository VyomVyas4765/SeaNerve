# Copy to .env and fill in. .env is gitignored.

# Roboflow classifier (optional: the rules classifier works without it)
ROBOFLOW_API_KEY=
# Project slug and version, e.g. seanerve-events/1
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Threshold profile: "demo" shortens the cable-protection waits (60 s -> 15 s)
SEANERVE_PROFILE=demo
